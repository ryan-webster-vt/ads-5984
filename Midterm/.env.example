# Generation: VT ARC OpenAI-compatible endpoint
OPEN_AI_ENDPOINT=
OPEN_AI_API_KEY=
OPEN_AI_MODEL=

# Optional per-stage generation models; unset stages fall back to OPEN_AI_MODEL.
# Typical split: fast model for optimize/rerank/followup, stronger model for
# generate/verify.
OPEN_AI_OPTIMIZE_MODEL=
OPEN_AI_RERANK_MODEL=
OPEN_AI_GENERATE_MODEL=
OPEN_AI_VERIFY_MODEL=
OPEN_AI_FOLLOWUP_MODEL=

# Embeddings: OpenAI-compatible embedding endpoint
OLLAMA_ENDPOINT=
EMBED_MODEL=

# Publication source: csv (default, reproducible) or elsevier (optional, live)
PUBLICATION_SOURCE=csv

# Optional Elsevier integration. Live access additionally requires entitlement
# and usually an institutional token. Without a key, CSV mode remains the
# supported path; Elsevier parsing is fixture-tested only.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
