{
  "$defs": {
    "ProgressStage": {
      "description": "Pipeline stages that can report progress.",
      "enum": [
        "ingest",
        "extract",
        "monitor",
        "score",
        "backtest",
        "validation",
        "demo",
        "config"
      ],
      "title": "ProgressStage",
      "type": "string"
    },
    "ProgressStatus": {
      "description": "Lifecycle state of a progress event.",
      "enum": [
        "started",
        "running",
        "completed",
        "failed",
        "skipped"
      ],
      "title": "ProgressStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A single ordered progress update for a run.",
  "properties": {
    "agent": {
      "minLength": 1,
      "title": "Agent",
      "type": "string"
    },
    "completed": {
      "default": 0,
      "minimum": 0,
      "title": "Completed",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_index": {
      "minimum": 0,
      "title": "Event Index",
      "type": "integer"
    },
    "game_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Game Id"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/ProgressStage"
    },
    "status": {
      "$ref": "#/$defs/ProgressStatus"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "total": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    }
  },
  "required": [
    "run_id",
    "event_index",
    "stage",
    "status",
    "agent",
    "message"
  ],
  "title": "ProgressEvent",
  "type": "object"
}
