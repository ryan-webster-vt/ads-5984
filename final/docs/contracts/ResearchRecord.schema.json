{
  "$defs": {
    "GameOdds": {
      "additionalProperties": false,
      "description": "Pregame odds used to define the favorite and the upset label.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "favorite_moneyline": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favorite Moneyline"
        },
        "favorite_team_id": {
          "minLength": 1,
          "title": "Favorite Team Id",
          "type": "string"
        },
        "provider": {
          "default": "espn",
          "title": "Provider",
          "type": "string"
        },
        "spread": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "underdog_moneyline": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underdog Moneyline"
        },
        "underdog_team_id": {
          "minLength": 1,
          "title": "Underdog Team Id",
          "type": "string"
        }
      },
      "required": [
        "favorite_team_id",
        "underdog_team_id"
      ],
      "title": "GameOdds",
      "type": "object"
    },
    "HistoricalGame": {
      "additionalProperties": false,
      "description": "A completed historical game used for research and extraction.",
      "properties": {
        "away_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Away Score"
        },
        "away_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "completed": {
          "default": true,
          "title": "Completed",
          "type": "boolean"
        },
        "game_date": {
          "format": "date",
          "title": "Game Date",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "home_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Score"
        },
        "home_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "neutral_site": {
          "default": false,
          "title": "Neutral Site",
          "type": "boolean"
        },
        "odds": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameOdds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "player_statistics": {
          "items": {
            "$ref": "#/$defs/PlayerStatistics"
          },
          "title": "Player Statistics",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "season": {
          "title": "Season",
          "type": "string"
        },
        "team_statistics": {
          "items": {
            "$ref": "#/$defs/TeamStatistics"
          },
          "title": "Team Statistics",
          "type": "array"
        },
        "tipoff_at": {
          "format": "date-time",
          "title": "Tipoff At",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "winner_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winner Team Id"
        }
      },
      "required": [
        "game_id",
        "season",
        "game_date",
        "tipoff_at",
        "home_team",
        "away_team"
      ],
      "title": "HistoricalGame",
      "type": "object"
    },
    "PlayerStatistics": {
      "additionalProperties": false,
      "description": "Structured player statistics retained for completeness and context.",
      "properties": {
        "assists_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assists Per Game"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "games_played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Games Played"
        },
        "minutes_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes Per Game"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "points_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Game"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "rebounds_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebounds Per Game"
        },
        "stats": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stats",
          "type": "object"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "name",
        "team_id"
      ],
      "title": "PlayerStatistics",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Audit metadata describing where an artifact came from.",
      "properties": {
        "actor": {
          "default": "system",
          "title": "Actor",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "source": {
          "default": "unknown",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "description": "A cited contextual document collected by the Context-Research worker.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_domain": {
          "minLength": 1,
          "title": "Source Domain",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "game_id",
        "url",
        "source_domain"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "TeamRef": {
      "additionalProperties": false,
      "description": "Reference to a team participating in a game.",
      "properties": {
        "abbreviation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbreviation"
        },
        "conference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conference"
        },
        "division": {
          "default": "D1",
          "title": "Division",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "name"
      ],
      "title": "TeamRef",
      "type": "object"
    },
    "TeamStatistics": {
      "additionalProperties": false,
      "description": "Structured team statistics with a provider-specific extension mapping.",
      "properties": {
        "adjusted_efficiency_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted Efficiency Margin"
        },
        "assists_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assists Per Game"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "defensive_efficiency": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defensive Efficiency"
        },
        "field_goal_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Goal Pct"
        },
        "free_throw_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Throw Pct"
        },
        "games_played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Games Played"
        },
        "offensive_efficiency": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offensive Efficiency"
        },
        "pace": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pace"
        },
        "points_allowed_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Allowed Per Game"
        },
        "points_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Game"
        },
        "rebounds_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebounds Per Game"
        },
        "stats": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stats",
          "type": "object"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "three_point_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Three Point Pct"
        },
        "turnovers_per_game": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnovers Per Game"
        }
      },
      "required": [
        "team_id"
      ],
      "title": "TeamStatistics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A joined research record for one game after orchestrator aggregation.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "historical_game": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoricalGame"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "game_id"
  ],
  "title": "ResearchRecord",
  "type": "object"
}
