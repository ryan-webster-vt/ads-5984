{
  "$defs": {
    "DailyGame": {
      "additionalProperties": false,
      "description": "A game on the current day's slate, including pregame context.",
      "properties": {
        "away_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Away Score"
        },
        "away_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "home_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Score"
        },
        "home_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "neutral_site": {
          "default": false,
          "title": "Neutral Site",
          "type": "boolean"
        },
        "odds": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameOdds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "player_statistics": {
          "items": {
            "$ref": "#/$defs/PlayerStatistics"
          },
          "title": "Player Statistics",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slate_date": {
          "format": "date",
          "title": "Slate Date",
          "type": "string"
        },
        "status": {
          "default": "scheduled",
          "enum": [
            "scheduled",
            "in_progress",
            "final",
            "postponed",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "team_statistics": {
          "items": {
            "$ref": "#/$defs/TeamStatistics"
          },
          "title": "Team Statistics",
          "type": "array"
        },
        "tipoff_at": {
          "format": "date-time",
          "title": "Tipoff At",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "required": [
        "game_id",
        "slate_date",
        "tipoff_at",
        "home_team",
        "away_team"
      ],
      "title": "DailyGame",
      "type": "object"
    },
    "GameOdds": {
      "additionalProperties": false,
      "description": "Pregame odds used to define the favorite and the upset label.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "favorite_moneyline": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favorite Moneyline"
        },
        "favorite_team_id": {
          "minLength": 1,
          "title": "Favorite Team Id",
          "type": "string"
        },
        "provider": {
          "default": "espn",
          "title": "Provider",
          "type": "string"
        },
        "spread": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "underdog_moneyline": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underdog Moneyline"
        },
        "underdog_team_id": {
          "minLength": 1,
          "title": "Underdog Team Id",
          "type": "string"
        }
      },
      "required": [
        "favorite_team_id",
        "underdog_team_id"
      ],
      "title": "GameOdds",
      "type": "object"
    },
    "PlayerStatistics": {
      "additionalProperties": false,
      "description": "Structured player statistics retained for completeness and context.",
      "properties": {
        "assists_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assists Per Game"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "games_played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Games Played"
        },
        "minutes_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes Per Game"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "points_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Game"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "rebounds_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebounds Per Game"
        },
        "stats": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stats",
          "type": "object"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "name",
        "team_id"
      ],
      "title": "PlayerStatistics",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Audit metadata describing where an artifact came from.",
      "properties": {
        "actor": {
          "default": "system",
          "title": "Actor",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "source": {
          "default": "unknown",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TeamRef": {
      "additionalProperties": false,
      "description": "Reference to a team participating in a game.",
      "properties": {
        "abbreviation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbreviation"
        },
        "conference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conference"
        },
        "division": {
          "default": "D1",
          "title": "Division",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "name"
      ],
      "title": "TeamRef",
      "type": "object"
    },
    "TeamStatistics": {
      "additionalProperties": false,
      "description": "Structured team statistics with a provider-specific extension mapping.",
      "properties": {
        "adjusted_efficiency_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted Efficiency Margin"
        },
        "assists_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assists Per Game"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "defensive_efficiency": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defensive Efficiency"
        },
        "field_goal_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Goal Pct"
        },
        "free_throw_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Throw Pct"
        },
        "games_played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Games Played"
        },
        "offensive_efficiency": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offensive Efficiency"
        },
        "pace": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pace"
        },
        "points_allowed_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Allowed Per Game"
        },
        "points_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points Per Game"
        },
        "rebounds_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebounds Per Game"
        },
        "stats": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stats",
          "type": "object"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "three_point_pct": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Three Point Pct"
        },
        "turnovers_per_game": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnovers Per Game"
        }
      },
      "required": [
        "team_id"
      ],
      "title": "TeamStatistics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The Division I vs. Division I slate for one calendar date.",
  "properties": {
    "games": {
      "items": {
        "$ref": "#/$defs/DailyGame"
      },
      "title": "Games",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slate_date": {
      "format": "date",
      "title": "Slate Date",
      "type": "string"
    },
    "source": {
      "default": "espn",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "slate_date"
  ],
  "title": "DailySlate",
  "type": "object"
}
