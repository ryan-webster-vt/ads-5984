{
  "additionalProperties": false,
  "description": "A deterministic chunk of a cited source document.",
  "properties": {
    "chunk_id": {
      "minLength": 1,
      "title": "Chunk Id",
      "type": "string"
    },
    "chunk_index": {
      "minimum": 0,
      "title": "Chunk Index",
      "type": "integer"
    },
    "document_hash": {
      "minLength": 1,
      "title": "Document Hash",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "end_char": {
      "minimum": 0,
      "title": "End Char",
      "type": "integer"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "season": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Season"
    },
    "source_domain": {
      "minLength": 1,
      "title": "Source Domain",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "start_char": {
      "minimum": 0,
      "title": "Start Char",
      "type": "integer"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "token_count": {
      "minimum": 1,
      "title": "Token Count",
      "type": "integer"
    },
    "whitelisted": {
      "default": true,
      "title": "Whitelisted",
      "type": "boolean"
    }
  },
  "required": [
    "chunk_id",
    "document_id",
    "game_id",
    "chunk_index",
    "text",
    "token_count",
    "start_char",
    "end_char",
    "source_url",
    "source_domain",
    "document_hash"
  ],
  "title": "DocumentChunk",
  "type": "object"
}
