{
  "$defs": {
    "DailyGame": {
      "additionalProperties": false,
      "description": "A game on the current day's slate, including pregame context.",
      "properties": {
        "away_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Away Score"
        },
        "away_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "home_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Score"
        },
        "home_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "neutral_site": {
          "default": false,
          "title": "Neutral Site",
          "type": "boolean"
        },
        "odds": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameOdds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "player_statistics": {
          "items": {
            "$ref": "#/$defs/PlayerStatistics"
          },
          "title": "Player Statistics",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slate_date": {
          "format": "date",
          "title": "Slate Date",
          "type": "string"
        },
        "status": {
          "default": "scheduled",
          "enum": [
            "scheduled",
            "in_progress",
            "final",
            "postponed",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "team_statistics": {
          "items": {
            "$ref": "#/$defs/TeamStatistics"
          },
          "title": "Team Statistics",
          "type": "array"
        },
        "tipoff_at": {
          "format": "date-time",
          "title": "Tipoff At",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "required": [
        "game_id",
        "slate_date",
        "tipoff_at",
        "home_team",
        "away_team"
      ],
      "title": "DailyGame",
      "type": "object"
    },
    "DocumentChunk": {
      "additionalProperties": false,
      "description": "A deterministic chunk of a cited source document.",
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_index": {
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "document_hash": {
          "minLength": 1,
          "title": "Document Hash",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "end_char": {
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "season": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season"
        },
        "source_domain": {
          "minLength": 1,
          "title": "Source Domain",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "token_count": {
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        },
        "whitelisted": {
          "default": true,
          "title": "Whitelisted",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "game_id",
        "chunk_index",
        "text",
        "token_count",
        "start_char",
        "end_char",
        "source_url",
        "source_domain",
        "document_hash"
      ],
      "title": "DocumentChunk",
      "type": "object"
    },
    "GameOdds": {
      "additionalProperties": false,
