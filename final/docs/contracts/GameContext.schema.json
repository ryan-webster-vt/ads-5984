  "additionalProperties": false,
  "description": "Current matchup data and cited pregame evidence for one game.\n\n``features`` carries deterministic pregame feature values keyed by the\nfeature names used in validated preconditions. It is the typed input to\ndeterministic Monitor rule evaluation; it is intentionally separate from\nprovider-specific statistics and from retrieved documents.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RetrievedEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Features",
      "type": "object"
    },
    "game": {
      "$ref": "#/$defs/DailyGame"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "team_statistics": {
      "items": {
        "$ref": "#/$defs/TeamStatistics"
      },
      "title": "Team Statistics",
      "type": "array"
    }
  },
  "required": [
    "game"
  ],
  "title": "GameContext",
  "type": "object"
}
