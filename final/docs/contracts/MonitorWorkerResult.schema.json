{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "description": "Serializable error record carried in agent results.\n\nThis contract is distinct from the ``AgentError`` exception in\n:mod:`upset_profiler.errors`; it is the on-the-wire representation.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "context": {
          "title": "Context",
          "type": "object"
        },
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A citable source attached to a claim, flag, or validated precondition.",
      "properties": {
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Id"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_domain": {
          "minLength": 1,
          "title": "Source Domain",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source_domain",
        "retrieved_at"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Comparison": {
      "description": "Supported comparison operators for precondition thresholds.",
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "in",
        "not_in"
      ],
      "title": "Comparison",
      "type": "string"
    },
    "GameFlag": {
      "additionalProperties": false,
      "description": "A game flagged as an upset candidate with cited rationale.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "flagged_at": {
          "format": "date-time",
          "title": "Flagged At",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/SignalMatch"
          },
          "minItems": 1,
          "title": "Signals",
          "type": "array"
        },
        "worker_id": {
          "minLength": 1,
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "worker_id",
        "signals",
        "rationale",
        "citations"
      ],
      "title": "GameFlag",
      "type": "object"
    },
    "SignalMatch": {
      "additionalProperties": false,
      "description": "Comparison of one validated precondition against a game's evidence.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "precondition_id": {
          "minLength": 1,
          "title": "Precondition Id",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "precondition_id",
        "matched",
        "comparison",
        "threshold",
        "explanation"
      ],
      "title": "SignalMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Flags and failures reported by one Monitor worker.",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "evaluated_game_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evaluated Game Ids",
      "type": "array"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/AgentError"
      },
      "title": "Failures",
      "type": "array"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/GameFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "worker_id": {
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "worker_id"
  ],
  "title": "MonitorWorkerResult",
  "type": "object"
}
