{
  "$defs": {
    "CalibrationBin": {
      "additionalProperties": false,
      "description": "One bin of a predicted-probability reliability diagram.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lower",
          "type": "number"
        },
        "mean_predicted": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Predicted",
          "type": "number"
        },
        "observed_upset_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Observed Upset Rate",
          "type": "number"
        },
        "upper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "count",
        "mean_predicted",
        "observed_upset_rate"
      ],
      "title": "CalibrationBin",
      "type": "object"
    },
    "EvaluationMetrics": {
      "additionalProperties": false,
      "description": "Aggregate classification metrics for one evaluated season split.",
      "properties": {
        "baseline_brier_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Brier Score"
        },
        "baseline_log_loss": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Log Loss"
        },
        "brier_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brier Score",
          "type": "number"
        },
        "calibration_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Error"
        },
        "log_loss": {
          "minimum": 0.0,
          "title": "Log Loss",
          "type": "number"
        },
        "positive_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Positive Rate",
          "type": "number"
        },
        "sample_size": {
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "required": [
        "log_loss",
        "brier_score",
        "sample_size",
        "positive_rate"
      ],
      "title": "EvaluationMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reproducible backtest report with train/validation/test season splits.",
  "properties": {
    "calibration_bins": {
      "items": {
        "$ref": "#/$defs/CalibrationBin"
      },
      "title": "Calibration Bins",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "test_metrics": {
      "$ref": "#/$defs/EvaluationMetrics"
    },
    "test_season": {
      "title": "Test Season",
      "type": "string"
    },
    "train_seasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Train Seasons",
      "type": "array"
    },
    "validation_metrics": {
      "$ref": "#/$defs/EvaluationMetrics"
    },
    "validation_season": {
      "title": "Validation Season",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "model_name",
    "train_seasons",
    "validation_season",
    "test_season",
    "validation_metrics",
    "test_metrics"
  ],
  "title": "BacktestReport",
  "type": "object"
}
