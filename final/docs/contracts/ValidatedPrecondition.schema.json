{
  "$defs": {
    "CandidatePrecondition": {
      "additionalProperties": false,
      "description": "A hypothesis that must pass deterministic statistical validation.",
      "properties": {
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "higher_increases_upset_risk"
        },
        "feature": {
          "minLength": 1,
          "title": "Feature",
          "type": "string"
        },
        "min_sample_size": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Sample Size"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "precondition_id": {
          "minLength": 1,
          "title": "Precondition Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "seed",
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "precondition_id",
        "name",
        "description",
        "feature",
        "comparison",
        "threshold"
      ],
      "title": "CandidatePrecondition",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A citable source attached to a claim, flag, or validated precondition.",
      "properties": {
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Id"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_domain": {
          "minLength": 1,
          "title": "Source Domain",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source_domain",
        "retrieved_at"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Comparison": {
      "description": "Supported comparison operators for precondition thresholds.",
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "in",
        "not_in"
      ],
      "title": "Comparison",
      "type": "string"
    },
    "Direction": {
      "description": "Expected direction of a precondition's effect on upset risk.",
      "enum": [
        "higher_increases_upset_risk",
        "lower_increases_upset_risk",
        "non_directional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EffectSize": {
      "additionalProperties": false,
      "description": "Estimated effect size with a confidence interval.",
      "properties": {
        "ci_lower": {
          "title": "Ci Lower",
          "type": "number"
        },
        "ci_upper": {
          "title": "Ci Upper",
          "type": "number"
        },
        "control_sample_size": {
          "minimum": 0,
          "title": "Control Sample Size",
          "type": "integer"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "treatment_sample_size": {
          "minimum": 0,
          "title": "Treatment Sample Size",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "ci_lower",
        "ci_upper",
        "method",
        "treatment_sample_size",
        "control_sample_size"
      ],
      "title": "EffectSize",
      "type": "object"
    },
    "OutOfSampleResult": {
      "additionalProperties": false,
      "description": "Out-of-sample predictive check for a candidate precondition.",
      "properties": {
        "baseline_value": {
          "title": "Baseline Value",
          "type": "number"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "train_seasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Train Seasons",
          "type": "array"
        },
        "validation_season": {
          "title": "Validation Season",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "train_seasons",
        "validation_season",
        "metric_name",
        "value",
        "baseline_value",
        "passed"
      ],
      "title": "OutOfSampleResult",
      "type": "object"
    },
    "StatisticalTest": {
      "additionalProperties": false,
      "description": "Result of a hypothesis test for a candidate precondition.",
      "properties": {
        "adjusted_p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted P Value"
        },
        "alpha": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Alpha",
          "type": "number"
        },
        "multiple_testing_corrected": {
          "default": false,
          "title": "Multiple Testing Corrected",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "p_value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Value",
          "type": "number"
        },
        "significant": {
          "title": "Significant",
          "type": "boolean"
        },
        "statistic": {
          "title": "Statistic",
          "type": "number"
        },
        "test_name": {
          "minLength": 1,
          "title": "Test Name",
          "type": "string"
        }
      },
      "required": [
        "test_name",
        "statistic",
        "p_value",
        "alpha",
        "significant"
      ],
      "title": "StatisticalTest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A precondition accepted by the Extractor and stored for monitoring.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidatePrecondition"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "minItems": 1,
      "title": "Citations",
      "type": "array"
    },
    "effect_size": {
      "$ref": "#/$defs/EffectSize"
    },
    "justification": {
      "minLength": 1,
      "title": "Justification",
      "type": "string"
    },
    "out_of_sample": {
      "$ref": "#/$defs/OutOfSampleResult"
    },
    "precondition_id": {
      "minLength": 1,
      "title": "Precondition Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "statistical_test": {
      "$ref": "#/$defs/StatisticalTest"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    },
    "validation_version": {
      "default": "1",
      "title": "Validation Version",
      "type": "string"
    }
  },
  "required": [
    "precondition_id",
    "candidate",
    "effect_size",
    "statistical_test",
    "out_of_sample",
    "citations",
    "justification"
  ],
  "title": "ValidatedPrecondition",
  "type": "object"
}
