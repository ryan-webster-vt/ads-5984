{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A citable source attached to a claim, flag, or validated precondition.",
      "properties": {
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Id"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_domain": {
          "minLength": 1,
          "title": "Source Domain",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source_domain",
        "retrieved_at"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Comparison": {
      "description": "Supported comparison operators for precondition thresholds.",
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "in",
        "not_in"
      ],
      "title": "Comparison",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Comparison of one validated precondition against a game's evidence.",
  "properties": {
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "comparison": {
      "$ref": "#/$defs/Comparison"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "matched": {
      "title": "Matched",
      "type": "boolean"
    },
    "observed_value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Value"
    },
    "precondition_id": {
      "minLength": 1,
      "title": "Precondition Id",
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Threshold"
    }
  },
  "required": [
    "precondition_id",
    "matched",
    "comparison",
    "threshold",
    "explanation"
  ],
  "title": "SignalMatch",
  "type": "object"
}
